# Copy to .env and fill in. Used by docker-compose.example.yml.
#
# Prometheus basic-auth credentials (USER:PASS). The prober sends these on
# remote_write; Grafana uses the password to query.
MON_REMOTE_WRITE_AUTH=mon:changeme
PROM_BASIC_AUTH_PASSWORD=changeme

# Grafana admin password (only applied on first init of the grafana volume).
GF_ADMIN_PASSWORD=changeme
